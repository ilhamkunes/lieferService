# Bu dosyayi kopyalayip ".env.local" olarak kaydet (ayni klasore) ve kendi degerlerini yaz.
# ".env.local" asla GitHub'a yuklenmez (.gitignore icinde), bu ornek dosya (.env.example) ise yuklenir.

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Developer Dashboard > Apps & Credentials (once Sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Resend (resend.com) > API Keys
RESEND_API_KEY=
RESTAURANT_NOTIFY_EMAIL=
